NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/elk-erp
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_NAME=elk_erp_token

# API base the Winner Desktop Connector should call (shown when creating a device).
# Local example: http://localhost:5000/api
# Production example: https://your-backend-host/api
WINNER_CONNECTOR_API_BASE=http://localhost:5000/api

# Render keep-alive (production). Pings public /api/health every 10 minutes.
# On Render, RENDER_EXTERNAL_URL is set automatically — or set KEEP_ALIVE_URL explicitly:
# KEEP_ALIVE_URL=https://your-service.onrender.com/api/health
# KEEP_ALIVE_INTERVAL_MS=600000
# KEEP_ALIVE_ENABLED=true

# ---------------------------------------------------------------------------
# Hardware Excel Sync (Office Script → pending Change Requests)
# Prefer TOKEN_HASH (bcrypt of the bearer token). Plain TOKEN is for local/dev
# and for pasting into office-scripts/HardwareMasterExcelSync.ts.
# USER_ID must be an active Administrator / Manager / Data Entry user.
# Generate:
#   node -e "require('bcrypt').hash(require('crypto').randomBytes(32).toString('base64url'),10).then(console.log)"
# ---------------------------------------------------------------------------
HARDWARE_EXCEL_SYNC_TOKEN=replace-with-generated-token
HARDWARE_EXCEL_SYNC_TOKEN_HASH=replace-with-bcrypt-hash-of-token
HARDWARE_EXCEL_SYNC_USER_ID=replace-with-active-write-role-user-objectid
HARDWARE_EXCEL_SYNC_MAX_ROWS=100
# Extra CORS origins (comma-separated), e.g. ngrok tunnels for script testing:
HARDWARE_EXCEL_SYNC_CORS_ORIGINS=
